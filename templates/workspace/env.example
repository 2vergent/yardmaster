# Template for every service's generated .env (`ym env <environment>`).
#
#   KEY=value             shared by all environments
#   MAIN_KEY=value        overrides KEY when the environment is `main`
#   APP_PORT=             filled with the service's own port
#   SVC_<PREFIX>_URL=     filled with http://localhost:<port> of that service
#
# Put real secrets in .env.local (git-ignored, same syntax) — it overrides
# anything here.

APP_PORT=
LOG_FORMAT=pretty
SVC_API_URL=
